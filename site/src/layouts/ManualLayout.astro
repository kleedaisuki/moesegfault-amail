---
import BaseLayout from './BaseLayout.astro';
import '../styles/manual.css';
import { candidateServiceNotice, releaseState } from '../releaseState';
import { releaseDownloads, releaseTagUrl } from '../releaseDownloads.mjs';

/** 中文：目录直接取 Astro 生成的标题锚点，避免手写目录漂移。 English: Derive the table of contents from generated heading anchors to prevent drift. */
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[]; frontmatter: { title: string; description: string } }
const { headings, frontmatter } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={`${frontmatter.title} · amail`} description={frontmatter.description} current="manual">
  <section class="page-head"><div class="wrap"><span class="eyebrow">The field guide</span><h1>用户手册<span class="period">.</span></h1><p>从第一次登录到发出一封完整的邮件。写给想掌握工作流的人，也写给会替你动手的 Agent。</p><p>{releaseState === 'published' ? <>v0.2.0 已发布。请从 <a href={releaseTagUrl}>GitHub Release</a> 取得安装包、Agent Skill 与校验文件。</> : 'v0.2.0 尚未开放下载；以下安装步骤供正式发布后使用。'}</p>{releaseState === 'candidate' && <p>{candidateServiceNotice}</p>}</div></section>
  <div class="wrap reading-layout">
    <nav class="toc" aria-label="用户手册目录"><p class="toc-title">目录 / Contents</p><ol>{sections.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : undefined}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
    <article class="prose manual-prose">
      {releaseState === 'published' && <section aria-label="v0.2.0 正式下载">
        <h2>下载 v0.2.0</h2>
        <p>选择与你设备匹配的原生安装包，同时下载校验清单。解压前按下方步骤核对 SHA-256；Agent Skill 也需要校验。</p>
        <ul>{releaseDownloads.map((asset) => <li><a href={asset.href}>{asset.label}</a></li>)}</ul>
      </section>}
      <slot />
    </article>
  </div>
</BaseLayout>
