# 中文：先创建专属 D1/R2 和 Cloudflare Access 应用并填入真实 ID；不要直接部署模板。
# English: Provision isolated D1/R2 and Access first; never deploy this sentinel template.
name = "amail-ops"
main = "build/worker/shim.mjs"
compatibility_date = "2026-09-28"
workers_dev = false
routes = [{ pattern = "ops.moesegfault.dev", custom_domain = true }]

[vars]
TEAM_DOMAIN = "https://REPLACE_TEAM.cloudflareaccess.com"
ACCESS_AUD = "REPLACE_ACCESS_APPLICATION_AUD"
OPS_ORIGIN = "https://ops.moesegfault.dev"
ROLE_DOMAIN = "mail.moesegfault.dev"
ALLOW_APEX_ROLES = "true"

[[d1_databases]]
binding = "OPS_DB"
database_name = "moesegfault-mail-ops-production"
database_id = "06e84adb-fe29-4183-b131-5042a48bcdee"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "OPS_REPORTS"
bucket_name = "moesegfault-mail-ops-reports-production"

[[send_email]]
name = "OFFICIAL_EMAIL"
allowed_sender_addresses = ["mail@moesegfault.dev"]
remote = true

[triggers]
crons = ["*/5 * * * *"]

# 中文：原始投诉包含个人资料，禁用自动请求、R2 与邮件事件跟踪。
# English: Raw reports contain personal data; disable automatic request/R2/email spans.
[observability]
enabled = false

[env.staging]
name = "amail-ops-staging"
workers_dev = false
routes = [{ pattern = "ops-staging.moesegfault.dev", custom_domain = true }]

[env.staging.vars]
TEAM_DOMAIN = "https://REPLACE_TEAM.cloudflareaccess.com"
ACCESS_AUD = "REPLACE_STAGING_ACCESS_APPLICATION_AUD"
OPS_ORIGIN = "https://ops-staging.moesegfault.dev"
ROLE_DOMAIN = "mail-staging.moesegfault.dev"
ALLOW_APEX_ROLES = "false"

[[env.staging.d1_databases]]
binding = "OPS_DB"
database_name = "moesegfault-mail-ops-staging"
database_id = "272e024c-453a-461b-bea0-c37a62c89d24"
migrations_dir = "migrations"

[[env.staging.r2_buckets]]
binding = "OPS_REPORTS"
bucket_name = "moesegfault-mail-ops-reports-staging"

[[env.staging.send_email]]
name = "OFFICIAL_EMAIL"
allowed_sender_addresses = ["mail@moesegfault.dev"]
remote = true

[env.staging.triggers]
crons = ["*/5 * * * *"]

[env.staging.observability]
enabled = false
